<Window x:Class="GptSalad.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GPT Salad" Width="420" Height="250" WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False">
  <Border Padding="18" Background="#FFF8F6F0" CornerRadius="12"><StackPanel>
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="GPT Salad · 选中文本" />
    <TextBox x:Name="SelectedText" Margin="0,12,0,8" Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
    <TextBlock x:Name="SourceLabel" Foreground="#666666" Margin="0,0,0,8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制文本" Width="88" Margin="0,0,8,0" Click="Copy_Click" /><Button Content="关闭" Width="72" Click="Close_Click" /></StackPanel>
  </StackPanel></Border>
</Window>
